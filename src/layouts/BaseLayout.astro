---
import "@/styles/global.css";
import { assetPath } from "@/lib/assets";
---

<!doctype html>
<html lang="fr">
  <head>
    <script is:inline>
      const colorPreference = window.matchMedia("(prefers-color-scheme: dark)");
      const applyTheme = () => {
        document.documentElement.classList.toggle(
          "dark",
          colorPreference.matches,
        );
        document.documentElement.style.colorScheme = colorPreference.matches
          ? "dark"
          : "light";
      };
      applyTheme();
      colorPreference.addEventListener("change", applyTheme);
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Ma wishlist : des envies à offrir ou à m’offrir."
    />
    <link rel="icon" type="image/svg+xml" href={assetPath("/favicon.svg")} />
    <title>Ma wishlist</title>
  </head>
  <body class="min-h-screen antialiased">
    <slot />
  </body>
</html>
