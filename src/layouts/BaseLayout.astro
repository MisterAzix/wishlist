---
import "@/styles/global.css";
import { assetPath } from "@/lib/assets";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      const colorPreference = window.matchMedia("(prefers-color-scheme: dark)");
      const isTheme = (value) =>
        value === "system" || value === "light" || value === "dark";
      const readTheme = () => {
        try {
          const stored = localStorage.getItem("wishlist-theme");
          return isTheme(stored) ? stored : "system";
        } catch {
          return "system";
        }
      };
      let themePreference = readTheme();
      const applyTheme = () => {
        const dark =
          themePreference === "dark" ||
          (themePreference === "system" && colorPreference.matches);
        document.documentElement.classList.toggle("dark", dark);
        document.documentElement.style.colorScheme = dark ? "dark" : "light";
        document.documentElement.dataset.theme = themePreference;
        window.dispatchEvent(new Event("wishlist:theme-updated"));
      };
      applyTheme();
      colorPreference.addEventListener("change", applyTheme);
      window.addEventListener("wishlist:theme-change", (event) => {
        if (!isTheme(event.detail)) return;
        themePreference = event.detail;
        try {
          localStorage.setItem("wishlist-theme", themePreference);
        } catch {
          // The theme remains usable when browser storage is unavailable.
        }
        applyTheme();
      });
      window.addEventListener("storage", (event) => {
        if (event.key !== "wishlist-theme" && event.key !== null) return;
        themePreference = readTheme();
        applyTheme();
      });
    </script>
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Wishlist Maxence : des envies à offrir ou à m’offrir."
    />
    <link rel="icon" type="image/svg+xml" href={assetPath("/favicon.svg")} />
    <title>Wishlist Maxence</title>
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <script>
      import "@/scripts/theme";
    </script>
  </body>
</html>
