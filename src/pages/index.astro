---
import { getCollection } from "astro:content";
import { ProductCard } from "@/components/ProductCard";
import { CategoryFilter } from "@/components/CategoryFilter";
import BaseLayout from "@/layouts/BaseLayout.astro";

const products = (await getCollection("products")).sort((a, b) =>
  a.id.localeCompare(b.id, "fr"),
);
const categories = [...new Set(products.map(({ data }) => data.category))].sort(
  (a, b) => a.localeCompare(b, "fr"),
);
---

<BaseLayout>
  <main class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-16">
    <header class="mb-8 flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight">Ma wishlist</h1>
        <p class="mt-2 text-base text-muted-foreground">
          À offrir ou à m’offrir.
        </p>
      </div>
      {products.length > 0 && <CategoryFilter categories={categories} />}
    </header>
    {products.length > 0 ? (
      <ul
        id="product-list"
        aria-label="Produits de ma wishlist"
        class="grid grid-cols-1 gap-5 min-[360px]:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
      >
        {products.map(({ id, data }) => (
          <li data-product={id} data-category={data.category}>
            <ProductCard product={data} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="py-12 text-muted-foreground">Aucune envie pour le moment.</p>
    )}
    <p id="filter-result" role="status" class="sr-only"></p>
    <p id="filter-empty" hidden class="py-12 text-muted-foreground">
      Aucune envie dans cette catégorie.
    </p>
  </main>
</BaseLayout>

<script>
  const filter = document.querySelector<HTMLSelectElement>("#category");
  const filterContainer =
    document.querySelector<HTMLElement>("#category-filter");
  const cards = document.querySelectorAll<HTMLElement>("[data-product]");
  const result = document.querySelector<HTMLElement>("#filter-result");
  const empty = document.querySelector<HTMLElement>("#filter-empty");

  if (filter && filterContainer) {
    filterContainer.hidden = false;
    const filterProducts = () => {
      let visible = 0;
      for (const card of cards) {
        card.hidden =
          filter.value !== "" && card.dataset.category !== filter.value;
        if (!card.hidden) visible += 1;
      }
      if (result) {
        result.textContent = `${visible} produit${visible > 1 ? "s" : ""} affiché${visible > 1 ? "s" : ""}`;
      }
      if (empty) empty.hidden = visible !== 0;
    };
    filter.addEventListener("change", filterProducts);
    filterProducts();
  }

  document.addEventListener(
    "error",
    (event) => {
      const image = event.target;
      if (
        image instanceof HTMLImageElement &&
        image.hasAttribute("data-product-image")
      ) {
        image.hidden = true;
        const fallback = image.parentElement?.querySelector<HTMLElement>(
          "[data-image-fallback]",
        );
        if (fallback) fallback.hidden = false;
      }
    },
    true,
  );
</script>
