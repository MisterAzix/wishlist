---
import { getCollection } from "astro:content";
import { ProductCard } from "@/components/ProductCard";
import { WishlistControls } from "@/components/WishlistControls";
import { ThemeSelector } from "@/components/ThemeSelector";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { compareProducts } from "@/lib/wishlist";

const products = (await getCollection("products"))
  .map(({ id, data }) => ({ id, ...data }))
  .sort(compareProducts("title-asc"));
const categories = [...new Set(products.map(({ category }) => category))].sort(
  (a, b) => a.localeCompare(b, "fr"),
);
const visibleCount = products.filter((product) => !product.archived).length;
---

<BaseLayout>
  <main class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-16">
    <header class="mb-8 flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight">Ma wishlist</h1>
        <p class="mt-2 text-base text-muted-foreground">
          À offrir ou à m’offrir.
        </p>
      </div>
      <ThemeSelector />
    </header>
    {products.length > 0 ? (
      <>
        <WishlistControls categories={categories} />
        <ul
          id="product-list"
          aria-label="Produits de ma wishlist"
          class="grid grid-cols-1 gap-5 min-[360px]:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
        >
          {products.map((product) => (
            <li
              hidden={product.archived}
              data-product={product.id}
              data-title={product.title}
              data-category={product.category}
              data-archived={String(product.archived)}
              data-price={product.price ?? ""}
              data-currency={product.currency}
            >
              <ProductCard product={product} />
            </li>
          ))}
        </ul>
      </>
    ) : (
      <p class="py-12 text-muted-foreground">Aucune envie pour le moment.</p>
    )}
    <p id="filter-result" role="status" class="sr-only">
      {visibleCount} produit{visibleCount > 1 ? "s" : ""} affiché
      {visibleCount > 1 ? "s" : ""}
    </p>
    <p
      id="filter-empty"
      hidden={products.length === 0 || visibleCount > 0}
      class="py-12 text-muted-foreground"
    >
      Toutes les envies sont déjà achetées.
    </p>
  </main>
</BaseLayout>

<script>
  import "@/scripts/wishlist";
</script>
